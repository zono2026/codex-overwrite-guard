{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command|functions\\.shell_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/validators/prevent_source_overwrite.py",
            "timeout": 10,
            "statusMessage": "Checking source-file overwrite guard"
          }
        ]
      }
    ]
  }
}
