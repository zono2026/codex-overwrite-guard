{
  "_comment": "Copy the appropriate block for your OS into ~/.claude/settings.json",

  "_macOS_Linux": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash|Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "python3 ~/.claude/validators/prevent_source_overwrite.py"
            }
          ]
        }
      ]
    }
  },

  "_Windows": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash|Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "python \"$env:USERPROFILE\\.claude\\validators\\prevent_source_overwrite.py\"",
              "shell": "powershell"
            }
          ]
        }
      ]
    }
  }
}
